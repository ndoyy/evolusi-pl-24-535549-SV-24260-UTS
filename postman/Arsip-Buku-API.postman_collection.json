{
    "info": {
        "name": "Arsip Buku API (UTS KEPL)",
        "description": "Jalankan folder secara berurutan: Autentikasi -> Buku -> Logout. Token dan id buku disimpan otomatis di variabel koleksi.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{token}}",
                "type": "string"
            }
        ]
    },
    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "exec": [
                    "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });"
                ]
            }
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000/api"
        },
        {
            "key": "token",
            "value": ""
        },
        {
            "key": "buku_id",
            "value": ""
        },
        {
            "key": "isbn",
            "value": ""
        }
    ],
    "item": [
        {
            "name": "Autentikasi",
            "item": [
                {
                    "name": "Login berhasil (200)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "const json = pm.response.json();",
                                    "pm.test('Mengembalikan access_token', () => pm.expect(json.access_token).to.be.a('string'));",
                                    "pm.collectionVariables.set('token', json.access_token);"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Login validasi gagal (422)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 422', () => pm.response.to.have.status(422));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Login kredensial salah (401)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"salah\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 401', () => pm.response.to.have.status(401));"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Buku (CRUD)",
            "item": [
                {
                    "name": "Daftar buku tanpa token (401)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/buku",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "buku"
                            ]
                        },
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 401', () => pm.response.to.have.status(401));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Tampil semua buku (200)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/buku",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "buku"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Berformat JSON dengan array data', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Cari buku (200)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/buku?search=Laravel",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "buku?search=Laravel"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Tambah buku (201)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/buku",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "buku"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"judul\": \"Pemrograman Laravel\",\n  \"penulis\": \"Budi Santoso\",\n  \"penerbit\": \"Informatika\",\n  \"tahun_terbit\": 2024,\n  \"isbn\": \"{{isbn}}\",\n  \"kategori\": \"Teknologi\",\n  \"stok\": 5,\n  \"deskripsi\": \"Contoh buku untuk pengujian Postman.\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "event": [
                        {
                            "listen": "prerequest",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.collectionVariables.set('isbn', '978' + Date.now().toString().slice(-10));"
                                ]
                            }
                        },
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 201', () => pm.response.to.have.status(201));",
                                    "pm.collectionVariables.set('buku_id', pm.response.json().data.id);"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Tambah buku validasi gagal (422)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/buku",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "buku"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"judul\": \"\",\n  \"isbn\": \"\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 422', () => pm.response.to.have.status(422));",
                                    "pm.test('Ada pesan error validasi', () => pm.expect(pm.response.json().errors).to.be.an('object'));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Tampil satu buku (200)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/buku/{{buku_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "buku",
                                "{{buku_id}}"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Ubah buku - PUT (200)",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/buku/{{buku_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "buku",
                                "{{buku_id}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"judul\": \"Pemrograman Laravel (Edisi Revisi)\",\n  \"penulis\": \"Budi Santoso\",\n  \"penerbit\": \"Informatika\",\n  \"tahun_terbit\": 2024,\n  \"isbn\": \"{{isbn}}\",\n  \"kategori\": \"Teknologi\",\n  \"stok\": 5,\n  \"deskripsi\": \"Contoh buku untuk pengujian Postman.\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));",
                                    "pm.test('Judul berubah', () => pm.expect(pm.response.json().data.judul).to.include('Revisi'));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Ubah sebagian - PATCH (200)",
                    "request": {
                        "method": "PATCH",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/buku/{{buku_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "buku",
                                "{{buku_id}}"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"stok\": 10\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Hapus buku (200)",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/buku/{{buku_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "buku",
                                "{{buku_id}}"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 200', () => pm.response.to.have.status(200));"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "Tampil buku yang sudah dihapus (404)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/buku/{{buku_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "buku",
                                "{{buku_id}}"
                            ]
                        }
                    },
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "pm.test('Status 404', () => pm.response.to.have.status(404));"
                                ]
                            }
                        }
                    ]
                }
            ]
        },
        {
            "name": "Logout",
            "item": [
                {
                    "name": "Logout (200)",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/logout",
                            "host": [
                                "{{base_url}}"
                            ],
